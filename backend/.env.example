# Copy to .env.development / .env.staging / .env.production and fill in real values.
# Never commit a populated env file.

APP_ENV=development
APP_NAME=AFS Financial CRM
API_V1_PREFIX=/api/v1
DEBUG=true

# The single business timezone for the whole app (Geo Fencing, Dashboard "today",
# reports, reminders, ...) — see docs/TIMEZONE.md. Storage stays UTC regardless.
APP_TIMEZONE=Asia/Kolkata

# MongoDB (replica set required for multi-document transactions)
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB_NAME=afs_crm

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# At-rest field encryption key (app/security/encryption.py). Optional in development
# (falls back to deriving from JWT_SECRET_KEY) — required, >= 32 random characters, in
# production.
ENCRYPTION_KEY=

# OTP / security policy
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
SECURE_LINK_EXPIRE_MINUTES=60
OTP_VERIFIED_TOKEN_EXPIRE_MINUTES=10

# development = fixed OTP (123456), logged to console, no SMS sent — no SMS provider
# wired up yet. production = real random OTP + real SMS delivery once one is. Flip this
# single flag (and configure SMS provider credentials) when deploying — see
# Settings.otp_mode.
OTP_MODE=development

# TEMPORARY — customer self-registration-only MSG91 DLT approval testing bypass (see
# Settings.registration_otp_bypass / CustomerService.bypass_verify_registration_mobile).
# While true, ANY valid mobile can skip SMS OTP during registration — this single flag is
# the only gate, so only set it to true in a controlled test window, then back to false.
# Never affects login/forgot-password/any other OTP purpose.
REGISTRATION_OTP_BYPASS=false

# AWS S3 — leave ACCESS_KEY_ID/SECRET_ACCESS_KEY as the placeholder "change-me" (or
# blank) to let boto3 resolve credentials from the EC2 instance's IAM role instead — the
# app treats "change-me"/empty as "not configured" and defers entirely to boto3's normal
# credential chain (see app/config/storage.py). Only set real values here if this
# deployment intentionally uses static access keys instead of an instance role.
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=ap-south-1
S3_BUCKET_NAME=afs-crm-documents

# CORS
CORS_ORIGINS=http://localhost:5173

# Where the Meta OAuth callback (GET /api/v1/integration-configs/oauth/callback) redirects
# the browser back to once Facebook login completes — the SPA's own origin. When testing
# locally with ngrok, this stays the localhost frontend URL; only the backend needs a
# public ngrok URL for Meta to reach.
FRONTEND_BASE_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
# Optional local dynamic text console. No model is downloaded or service activated.
VOICE_LOCAL_AI_ENABLED=false
# JSON array; private inference hosts require explicit operator approval and TLS.
VOICE_LOCAL_AI_ALLOWED_ORIGINS=[]
# Native PBX origins allowed for read-only ARI probes; empty blocks all requests.
# Example after approval: ["https://pbx.example.internal:8089"]
VOICE_NATIVE_ALLOWED_ORIGINS=[]
# Optional operator-installed local speech profiles. See docs/VOICE_PLATFORM_OPERATIONS.md.
# No executable, model or approved reference audio is assumed present.
VOICE_SPEECH_ROOT=
VOICE_SPEECH_PROFILES={}
VOICE_SPEECH_TIMEOUT_SECONDS=60
VOICE_SPEECH_THREADS=2
VOICE_SPEECH_MEMORY_LIMIT_MB=2048
VOICE_LOCAL_AI_URL=http://127.0.0.1:11434
VOICE_LOCAL_AI_MODEL=
# Optional private encrypted imported-artifact storage. Empty disables audio import.
# Compose mounts this directory into both API and ARQ; provision permissions/backups first.
# VOICE_RECORDINGS_DIR=/var/lib/afs/voice-recordings
VOICE_RECORDINGS_DIR=
